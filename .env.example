# Copy this file to `.env` (which is git-ignored) and fill in real values.
# Real keys live in your private secrets folder (~/.secrets), never in this repository.

# Supabase (MIAM OS backend) — Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-side only, never ship to the browser
SUPABASE_DB_URL=                  # postgres://... for migrations / seed

# Hosting (site/) — Vercel or Netlify token used by the deploy step
DEPLOY_TOKEN=

# Google Business Profile / Maps (docs/07-local-seo.md)
GOOGLE_MAPS_API_KEY=

# Meta Ads / Instagram (docs/11-meta-ads.md, docs/10-social.md)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# Loyalty / CRM email provider (docs/12-loyalty-crm.md)
EMAIL_PROVIDER_API_KEY=
